molden.from_mo(mol, 'local1_int_1813.molden',localized_mo1)
las.max_cycle_macro=200
las.kernel(localized_mo1)
molden.from_lasscf(las, 'int1_lasscf_1813_2frag.molden')

mc= mcscf.CASSCF(mf,18,(11,7))
