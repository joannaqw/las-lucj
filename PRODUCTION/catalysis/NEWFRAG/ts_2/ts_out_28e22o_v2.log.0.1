mc.kernel(localized_mo1)

localized_mo2=las.set_fragments_(([24,26],[28,29,30,31,32,33]),sorted_mo)
molden.from_mo(mol, 'local2_ts_1813.molden',localized_mo2)
#scheme 1: [Fe-O_bot] | [0-CH4]
