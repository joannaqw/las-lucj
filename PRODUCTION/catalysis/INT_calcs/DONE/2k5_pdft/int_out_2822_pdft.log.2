    postselect_by_hamming_right_and_left,
    subsample,
    recover_configurations,
    get_carryover_full_strs,
)
norb = 22
nelec = 28 
norb_f = (10,3,3,3,3)
jw_nelec = (16,12)
nelec_f = ((8,4),(2,2),(2,2),(2,2),(2,2))

ncore = las.ncore
